/project/.trivyignore.yaml                  @LOGIN_VOZHAKOV @LOGIN_MERKULOV
/project/deploy/                            @LOGIN_MERKULOV @LOGIN_VOZHAKOV
/project/migrations/env.py                  @LOGIN_MERKULOV @LOGIN_ERMAKOV

