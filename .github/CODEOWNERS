/project/pyproject.toml                     @LOGIN_MERKULOV @LOGIN_ERMAKOV
/project/CONTRIBUTING.md                    @LOGIN_MERKULOV @LOGIN_ERMAKOV @LOGIN_VOZHAKOV

# Тесты
/project/tests/                             @LOGIN_ERMAKOV @LOGIN_VOZHAKOV @LOGIN_MERKULOV

# Контейнеры, зависимости, развёртывание, миграции
