# Настройки контейнерного окружения (ЛР4, пункт 4).
#
# Рабочий файл — .env.docker рядом с этим образцом. Он не попадает ни в git
# (.gitignore), ни в образ (.dockerignore): секреты передаются контейнерам
# переменными окружения только в момент запуска.
#
# Создать файл со случайными паролями одной командой:
#     make docker-env
#
# Отдельный файл, а не .env: в .env лежат адреса стенда ЛР2 и ЛР3
# (база на audfond-db), а у контейнеров своя база в своей сети.

# Профиль приложения
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# Адрес на машине, по которому открывается сервис. Наружу публикуется только
# Nginx: приложение и база снаружи недоступны (пункты 8 и доп. 2)
HTTP_PORT=8080
# На каком адресе машины слушать. Docker публикует порт в обход ufw, поэтому
# ограничивать надо здесь: на стенде — только адрес сети host-only
HTTP_BIND=0.0.0.0
# HTTP_BIND=192.168.56.10

# База в контейнере. Пароль — длинный случайный, заглушка не годится
POSTGRES_DB=audfond
POSTGRES_USER=audfond
POSTGRES_PASSWORD=CHANGE_ME

# Ключ подписи токенов. Общий для всех экземпляров приложения: токен,
# выданный одним экземпляром, должен приниматься другим
JWT_SECRET=CHANGE_ME_СГЕНЕРИРУЙТЕ_СВОЙ_КЛЮЧ
JWT_TTL_MINUTES=60

# Сервис отдаётся по http, поэтому Secure у cookie выключен (см. .env.example)
COOKIE_SECURE=false

# Первый администратор: make create-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_FULL_NAME="Администратор системы"

# Демонстрационные данные: make seed
SEED_PASSWORD=CHANGE_ME_демо_пароль

# Коммит, из которого собран образ; make build подставляет сам
GIT_COMMIT=unknown
