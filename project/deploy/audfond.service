# Служба приложения AudFond. Пункты задания 8 и 9.
#
# Установка выполняется скриптом 03-app-server.sh; руками копировать не нужно.
# Миграции здесь НЕ выполняются осознанно: накат схемы — шаг развёртывания
# (deploy.sh), а не шаг запуска. У пользователя, от которого работает служба,
# прав менять схему нет вовсе.

[Unit]
Description=AudFond — аудиторный фонд университета
Documentation=file:///opt/audfond/docs/deploy.md
After=network-online.target
Wants=network-online.target

# Предохранитель от бесконечного цикла перезапусков: пять попыток за минуту,
# дальше служба останавливается и ждёт человека. Ключи относятся к [Unit],
# а не к [Service] — частая ошибка, systemd молча их игнорирует.
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=exec
User=audfond
Group=audfond
WorkingDirectory=/opt/audfond

# Настройки лежат отдельно от исходного кода (пункт задания 11).
# Файл принадлежит root, читать его может только группа audfond.
EnvironmentFile=/etc/audfond/audfond.env

ExecStart=/opt/audfond/.venv/bin/uvicorn wsgi:app \
    --host ${APP_HOST} --port ${APP_PORT} \
    --no-access-log --timeout-graceful-shutdown 10

ExecReload=/bin/kill -HUP $MAINPID

# Автоматический перезапуск после аварийного завершения (пункт 9)
Restart=on-failure
RestartSec=5s

# Корректное завершение по сигналу
KillSignal=SIGTERM
TimeoutStopSec=20s

# Ограничение прав процесса: приложению не нужен доступ к чужим каталогам
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/opt/audfond/backups

StandardOutput=journal
StandardError=journal
SyslogIdentifier=audfond

[Install]
WantedBy=multi-user.target
