# Настройки сервера приложения. Пункт задания 11: конфигурация передаётся
# отдельно от исходного кода.
#
# Боевой файл лежит в /etc/audfond/audfond.env, принадлежит root:audfond и
# имеет права 640: служба его читает, посторонние — нет.
# В репозитории хранится только этот образец, без настоящих паролей.

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# Приложение ходит в базу под ролью af_app: читать и писать данные может,
# менять схему — нет. Адрес сервера базы — внутренний адрес стенда.
DATABASE_URL=postgresql+psycopg://af_app:ПАРОЛЬ_ПРИЛОЖЕНИЯ@192.168.56.11:5432/audfond

# Ключ подписи токенов. Без него приложение не стартует.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=СГЕНЕРИРУЙТЕ_СВОЙ_КЛЮЧ
JWT_TTL_MINUTES=60

# Флаг Secure у cookie с токеном входа.
#   false — приложение отдаётся по http (стенд лабораторной работы).
#   true  — перед приложением стоит прокси с TLS и адрес начинается с https.
# Важно: браузер НЕ сохраняет cookie с флагом Secure, полученную по http.
# Если здесь true, а в адресной строке http, вход внешне не работает:
# пароль принимается, но страница возвращает на форму входа.
COOKIE_SECURE=false

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

LOG_LEVEL=INFO
LOG_FORMAT=json

PAGE_SIZE_DEFAULT=50
PAGE_SIZE_MAX=200
MAX_UPLOAD_BYTES=20971520

# Подставляется скриптом развёртывания, отдаётся адресом /version
GIT_COMMIT=unknown
