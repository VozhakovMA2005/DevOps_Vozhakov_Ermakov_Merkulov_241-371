# Профиль приложения: development | test | production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ОБЯЗАТЕЛЬНО. Без этой переменной приложение не стартует.
DATABASE_URL=postgresql+psycopg://audfond:CHANGE_ME@localhost:5432/audfond

# ОБЯЗАТЕЛЬНО. Ключ подписи токенов доступа (ТЗ 4.6).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_СГЕНЕРИРУЙТЕ_СВОЙ_КЛЮЧ
JWT_TTL_MINUTES=60

# Защита точки входа от подбора пароля (ТЗ 4.1.1)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Составные части адреса базы для docker compose
POSTGRES_DB=audfond
POSTGRES_USER=audfond
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT_EXPOSED=5433

# Первый администратор: создаётся командой make create-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_FULL_NAME=Администратор системы

LOG_LEVEL=INFO
LOG_FORMAT=json

PAGE_SIZE_DEFAULT=50
PAGE_SIZE_MAX=200
MAX_UPLOAD_BYTES=20971520

# Подставляется при сборке образа, отдаётся адресом /version
GIT_COMMIT=unknown
