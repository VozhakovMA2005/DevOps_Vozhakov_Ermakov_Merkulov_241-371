# Секреты и локальное окружение — в репозиторий не попадают (ТЗ, раздел 5)
.env
.env.*
!.env.example
!.env.docker.example

# Виртуальные окружения
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

